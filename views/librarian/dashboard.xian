
{{> head}}
<body class="bg-[#0B1120] text-gray-100">

  <!-- HEADER BAR -->
   <div class="bg-[#111A2B] border-b border-[#1B2940] text-[#22D3C5] px-8 py-8 font-medium shadow flex justify-between items-center">
  <span>Welcome, {{userName}}!</span>
  <span class="text-[#22D3C5]">Librarian Dashboard</span>
  </div>
  
  <div class="flex min-h-[calc(100vh-60px)]">

    <!-- SIDEBAR -->
    <div class="w-40 bg-[#111A2B] p-6 shadow border-r border-[#1B2940]">
      <button type="button" onclick="openAddModal()"
              class="block w-full text-left px-4 py-3 mb-2 rounded-lg text-gray-300 hover:bg-[#1B2940] hover:text-[#5EEAD4]">
         Add New
      </button>
      <a href="/dashboard"
         class="block w-full px-4 py-3 mb-2 rounded-lg text-gray-300 hover:bg-[#1B2940] hover:text-[#5EEAD4]">
         View All
      </a>
      <a href="/logout"
         class="block w-full px-4 py-3 mb-2 rounded-lg text-red-400 font-medium hover:bg-red-900/30">
         Logout
      </a>
    </div>

    <!-- CONTENT -->
    <div class="flex-1 p-8">
      <h1 class="text-2xl font-bold text-white"> All Books</h1>
      <p class="text-gray-400 mt-1 mb-6"></p>

      <!-- GREEN FLASH NOTIFICATION -->
      {{#if success_msg}}
        <div class="bg-green-900/30 border border-green-700 text-green-300 px-4 py-3 rounded mt-4 mb-4 text-center">
          {{success_msg}}
        </div>
      {{/if}}

      {{#if error_msg}}
        <div class="bg-red-900/30 border border-red-700 text-red-300 px-4 py-3 rounded mt-4 mb-4 text-center">
          {{error_msg}}
        </div>
      {{/if}}

      {{#if books}}
        <div class="bg-[#111A2B] border border-[#1B2940] rounded-lg shadow overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-[#1B2940] text-left">
                <th class="px-4 py-3 font-semibold text-gray-200">Name</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Category</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Author</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Publisher</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Price</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Year</th>
                <th class="px-4 py-3 font-semibold text-gray-200">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each books}}
                <tr class="border-t border-[#1B2940] hover:bg-[#1B2940]/60">
                  <td class="px-4 py-3 text-gray-100">{{Name}}</td>
                  <td class="px-4 py-3 text-gray-300">{{#if category}}{{category}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3 text-gray-300">{{author}}</td>
                  <td class="px-4 py-3 text-gray-300">{{#if publisher}}{{publisher}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3 text-gray-300">{{#if price}}{{price}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3 text-gray-300">{{#if pub_year}}{{pub_year}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3">
                    <button type="button" onclick="editBook(this)"
                            data-id="{{id}}"
                            data-name="{{Name}}"
                            data-category="{{category}}"
                            data-author="{{author}}"
                            data-publisher="{{publisher}}"
                            data-price="{{price}}"
                            data-pub-year="{{pub_year}}"
                            class="bg-[#22D3C5] text-[#0B1120] px-3 py-1 rounded text-sm mr-1 hover:bg-[#5EEAD4] font-medium">
                      Edit
                    </button>
                    <button type="button" onclick="openDeleteModal(this)"
                            data-id="{{id}}"
                            data-name="{{Name}}"
                            class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700">
                      Delete
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="bg-[#111A2B] border border-[#1B2940] rounded-lg shadow p-8 text-center text-gray-400">
          No books yet. Click "Add New" to add your first book.
        </div>
      {{/if}}
    </div>
  </div>

  <!-- ADD MODAL -->
  <div id="addModal" class="hidden fixed inset-0 z-50 bg-black/70 items-center justify-center p-4">
    <div class="bg-[#111A2B] border border-[#1B2940] text-gray-100 w-full max-w-lg rounded-lg p-6">
      <h2 class="text-xl font-bold mb-4 text-white">Add Book</h2>
      <form method="POST" action="/insert">
        <label class="block mb-1 text-gray-300">Book Name</label>
        <input name="Name" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Category</label>
        <input name="category" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Author</label>
        <input name="author" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Publisher</label>
        <input name="publisher" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Price</label>
        <input name="price" type="number" step="0.01" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Publication Year</label>
        <input name="pub_year" type="number" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-4 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <div class="flex justify-end gap-2">
          <button type="button" onclick="hideModal('addModal')" class="bg-[#1B2940] text-gray-200 px-4 py-2 rounded hover:bg-slate-700">
            Cancel
          </button>
          <button type="submit" class="bg-[#22D3C5] text-[#0B1120] px-4 py-2 rounded hover:bg-[#5EEAD4] font-semibold">
            Add Book
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT MODAL -->
  <div id="editModal" class="hidden fixed inset-0 z-50 bg-black/70 items-center justify-center p-4">
    <div class="bg-[#111A2B] border border-[#1B2940] text-gray-100 w-full max-w-lg rounded-lg p-6">
      <h2 class="text-xl font-bold mb-4 text-white">Edit Book</h2>
      <form id="editForm" method="POST">
        <label class="block mb-1 text-gray-300">Book Name</label>
        <input id="editName" name="Name" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Category</label>
        <input id="editCategory" name="category" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Author</label>
        <input id="editAuthor" name="author" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Publisher</label>
        <input id="editPublisher" name="publisher" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Price</label>
        <input id="editPrice" name="price" type="number" step="0.01" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-3 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <label class="block mb-1 text-gray-300">Publication Year</label>
        <input id="editPubYear" name="pub_year" type="number" required class="bg-[#0B1120] border border-[#1B2940] text-white p-2 w-full mb-4 rounded focus:outline-none focus:ring-2 focus:ring-[#22D3C5]">

        <div class="flex justify-end gap-2">
          <button type="button" onclick="hideModal('editModal')" class="bg-[#1B2940] text-gray-200 px-4 py-2 rounded hover:bg-slate-700">
            Cancel
          </button>
          <button type="submit" class="bg-[#22D3C5] text-[#0B1120] px-4 py-2 rounded hover:bg-[#5EEAD4] font-semibold">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE MODAL -->
  <div id="deleteModal" class="hidden fixed inset-0 z-[60] bg-black/70 items-center justify-center p-4">
    <div class="bg-[#111A2B] border border-[#1B2940] text-gray-100 w-full max-w-sm rounded-xl p-6 shadow-xl">
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-900/40">
          <span class="text-3xl text-red-400">!</span>
        </div>
        <h2 class="text-xl font-bold text-white">Delete Book?</h2>
        <p class="text-gray-300 mt-2">
          Are you sure you want to delete <strong id="deleteBookName" class="text-white"></strong>?
          This action cannot be undone.
        </p>
      </div>
      <div class="flex justify-center gap-3 mt-6">
        <button type="button" onclick="hideModal('deleteModal')" class="px-4 py-2 rounded-lg bg-[#1B2940] text-gray-200 hover:bg-slate-700">
          Cancel
        </button>
        <button type="button" onclick="confirmDeleteBook()" class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700">
          Yes, Delete
        </button>
      </div>
    </div>
  </div>

  <script>
   
    function showModal(id) {
      const modal = document.getElementById(id);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function hideModal(id) {
      const modal = document.getElementById(id);
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

 
    function openAddModal() {
      showModal('addModal');
    }


    function editBook(button) {
      const id = button.dataset.id;
      document.getElementById('editName').value = button.dataset.name;
      document.getElementById('editCategory').value = button.dataset.category;
      document.getElementById('editAuthor').value = button.dataset.author;
      document.getElementById('editPublisher').value = button.dataset.publisher;
      document.getElementById('editPrice').value = button.dataset.price;
      document.getElementById('editPubYear').value = button.dataset.pubYear;

     
      document.getElementById('editForm').action = '/books/' + encodeURIComponent(id);
      showModal('editModal');
    }


    let selectedBookId = null;

    function openDeleteModal(button) {
      selectedBookId = button.dataset.id;
      document.getElementById('deleteBookName').textContent = button.dataset.name;
      showModal('deleteModal');
    }

    async function confirmDeleteBook() {
      if (!selectedBookId) {
        alert('No book selected.');
        return;
      }

      try {
        const response = await fetch(
          '/books/' + encodeURIComponent(selectedBookId),
          { method: 'DELETE' }
        );

        if (!response.ok) throw new Error('Failed to delete book.');

        const data = await response.json();
        window.location.href = data.redirect || '/dashboard';
      } catch (error) {
        console.error('Delete error:', error);
        alert(error.message);
      }
    }
  </script>

{{> footer }}
