{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-4 py-8 max-w-lg">
    <h1 class="text-2xl font-bold mb-6"> Add New Book</h1>

    <form action="/insert" method="POST" class="bg-white p-6 rounded-lg shadow">
      <label class="block mb-1">Name</label>
      <input type="text" name="Name" required placeholder="Name"
             class="border p-2 w-full mb-3 rounded">

      <label class="block mb-1">Category</label>
      <input type="text" name="category" required placeholder="category"
             class="border p-2 w-full mb-3 rounded">

      <label class="block mb-1">Author</label>
      <input type="text" name="author" required placeholder="author"
             class="border p-2 w-full mb-3 rounded">

      <label class="block mb-1">Publisher</label>
      <input type="text" name="publisher" required placeholder="publisher"
             class="border p-2 w-full mb-3 rounded">

      <label class="block mb-1">Price</label>
      <input type="number" step="0.01" name="price" required placeholder="price"
             class="border p-2 w-full mb-3 rounded">

      <label class="block mb-1">Publish Year</label>
      <input type="number" name="pub_year" required placeholder="pub_year"
             class="border p-2 w-full mb-4 rounded">

      <div class="flex justify-end gap-2">
        <a href="/dashboard" class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400">Cancel</a>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Save Book</button>
      </div>
    </form>
  </div>
{{> footer }}
