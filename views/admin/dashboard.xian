
{{> head}}
<body class="bg-[#0B1120] text-slate-200">

  <!-- HEADER BAR -->
  <div class="bg-[#111A2B] border-b border-[#1B2940] text-[#22D3C5] px-8 py-8 font-medium shadow flex justify-between items-center">
  <span>Welcome, {{userName}}!</span>
  <span class="text-[#22D3C5]">Admin Dashboard</span>
  </div>

  <div class="flex min-h-[calc(100vh-60px)]">

    <!-- SIDEBAR -->
    <div class="w-40 bg-[#111A2B] border-r border-slate-800 p-7 shadow-xl">
      <button type="button" onclick="openAddModal()"
        class="block w-full text-left px-4 py-3 mb-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-[#22D3C5] transition-colors">
         Add New
      </button>

      <a href="/dashboard"
        class="block w-full px-4 py-3 mb-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-[#22D3C5] transition-colors">
         View All
      </a>

      <a href="/users"
        class="block w-full px-4 py-3 mb-2 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-[#22D3C5] transition-colors">
         Users
      </a>

      <a href="/logout"
        class="block w-full px-4 py-3 mb-2 rounded-lg text-rose-400 font-medium hover:bg-rose-500/10 transition-colors">
         Logout
      </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="flex-1 p-8">
      <h1 class="text-2xl font-bold text-slate-100"> All Books</h1>
      <p class="text-slate-400 mt-1 mb-6">
       
      </p>

      {{#if success_msg}}
        <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl mt-4 mb-4 text-center">
          {{success_msg}}
        </div>
      {{/if}}

      {{#if error_msg}}
        <div class="bg-rose-500/10 border border-rose-500/30 text-rose-300 px-4 py-3 rounded-xl mt-4 mb-4 text-center">
          {{error_msg}}
        </div>
      {{/if}}

      {{#if books}}
        <div class="bg-[#111A2B] border border-slate-800 rounded-xl shadow-xl overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="bg-[#1B2940] text-left">
                <th class="px-4 py-3 font-semibold text-slate-200">Name</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Category</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Author</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Publisher</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Price</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Year</th>
                <th class="px-4 py-3 font-semibold text-slate-200">Actions</th>
              </tr>
            </thead>

            <tbody>
              {{#each books}}
                <tr class="border-t border-slate-800/80 hover:bg-slate-800/50 transition-colors">
                  <td class="px-4 py-3">{{Name}}</td>
                  <td class="px-4 py-3">{{#if category}}{{category}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3">{{author}}</td>
                  <td class="px-4 py-3">{{#if publisher}}{{publisher}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3">{{#if price}}{{price}}{{else}}-{{/if}}</td>
                  <td class="px-4 py-3">{{#if pub_year}}{{pub_year}}{{else}}-{{/if}}</td>

                  <td class="px-4 py-3 whitespace-nowrap">
                    <button type="button" onclick="editBook(this)"
                      data-id="{{id}}"
                      data-name="{{Name}}"
                      data-category="{{category}}"
                      data-author="{{author}}"
                      data-publisher="{{publisher}}"
                      data-price="{{price}}"
                      data-pub-year="{{pub_year}}"
                      class="bg-sky-500/15 text-sky-300 border border-sky-400/20 px-3 py-1 rounded-lg text-sm mr-1 hover:bg-sky-500/25 transition-colors">
                      Edit
                    </button>

                    <button type="button" onclick="openDeleteModal(this)"
                      data-id="{{id}}"
                      data-name="{{Name}}"
                      class="bg-rose-500/15 text-rose-300 border border-rose-400/20 px-3 py-1 rounded-lg text-sm hover:bg-rose-500/25 transition-colors">
                      Delete
                    </button>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="bg-[#111A2B] border border-slate-800 rounded-xl shadow-xl p-8 text-center text-slate-400">
          No books yet. Click "Add New" to add your first book.
        </div>
      {{/if}}
    </div>
  </div>

  <!-- ADD BOOK MODAL -->
  <div id="addModal" class="hidden fixed inset-0 z-50 bg-black/70 items-center justify-center p-4">
    <div class="bg-[#151F32] border border-slate-700 w-full max-w-lg rounded-2xl p-6 text-slate-200 shadow-2xl">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Add Book</h2>

      <form method="POST" action="/insert">
        <label class="block mb-1 text-slate-300 text-sm font-medium">Book Name</label>
        <input name="Name" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Category</label>
        <input name="category" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Author</label>
        <input name="author" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Publisher</label>
        <input name="publisher" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Price</label>
        <input name="price" type="number" step="0.01" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Publication Year</label>
        <input name="pub_year" type="number" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50 focus:border-[#22D3C5]">

        <div class="flex justify-end gap-2">
          <button type="button" onclick="hideModal('addModal')" class="bg-slate-700 text-slate-200 px-4 py-2 rounded-lg hover:bg-slate-600">
            Cancel
          </button>

          <button type="submit" class="bg-[#22D3C5] text-[#0B1120] font-semibold px-4 py-2 rounded-lg hover:bg-[#5EEAD4]">
            Add Book
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT BOOK MODAL -->
  <div id="editModal" class="hidden fixed inset-0 z-50 bg-black/70 items-center justify-center p-4">
    <div class="bg-[#151F32] border border-slate-700 w-full max-w-lg rounded-2xl p-6 text-slate-200 shadow-2xl">
      <h2 class="text-xl font-bold text-slate-100 mb-4">Edit Book</h2>

      <form id="editForm" method="POST">
        <label class="block mb-1 text-slate-300 text-sm font-medium">Book Name</label>
        <input id="editName" name="Name" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Category</label>
        <input id="editCategory" name="category" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Author</label>
        <input id="editAuthor" name="author" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Publisher</label>
        <input id="editPublisher" name="publisher" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Price</label>
        <input id="editPrice" name="price" type="number" step="0.01" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <label class="block mb-1 text-slate-300 text-sm font-medium">Publication Year</label>
        <input id="editPubYear" name="pub_year" type="number" required class="bg-[#0B1120] border border-slate-700 text-slate-100 p-2.5 w-full mb-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#22D3C5]/50">

        <div class="flex justify-end gap-2">
          <button type="button" onclick="hideModal('editModal')" class="bg-slate-700 text-slate-200 px-4 py-2 rounded-lg hover:bg-slate-600">
            Cancel
          </button>

          <button type="submit" class="bg-[#22D3C5] text-[#0B1120] font-semibold px-4 py-2 rounded-lg hover:bg-[#5EEAD4]">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="hidden fixed inset-0 z-[60] bg-black/70 items-center justify-center p-4">
    <div class="bg-[#151F32] border border-slate-700 w-full max-w-sm rounded-2xl p-6 shadow-2xl text-slate-200">
      <div class="text-center">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-rose-500/15">
          <span class="text-3xl text-rose-400">!</span>
        </div>

        <h2 class="text-xl font-bold text-slate-100">Delete Book?</h2>

        <p class="text-slate-400 mt-2">
          Are you sure you want to delete
          <strong id="deleteBookName" class="text-slate-100"></strong>?
          This action cannot be undone.
        </p>
      </div>

      <div class="flex justify-center gap-3 mt-6">
        <button type="button" onclick="hideModal('deleteModal')" class="px-4 py-2 rounded-lg bg-slate-700 text-slate-200 hover:bg-slate-600">
          Cancel
        </button>

        <button type="button" onclick="confirmDeleteBook()" class="px-4 py-2 rounded-lg bg-rose-500 text-white hover:bg-rose-600">
          Yes, Delete
        </button>
      </div>
    </div>
  </div>

  <!-- DARK MODE STYLES -->
  <style>
    html {
      color-scheme: dark;
    }

    body {
      background: #0B1120;
    }

    table th {
      white-space: nowrap;
    }

    table td,
    table th {
      border-color: #263449;
    }

    input,
    select,
    textarea {
      color-scheme: dark;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    ::selection {
      background: rgba(34, 211, 197, .28);
      color: #E2E8F0;
    }

    * {
      scrollbar-color: #334155 #0B1120;
      scrollbar-width: thin;
    }
  </style>

  <!-- JAVASCRIPT FUNCTIONS -->
  <script>
    function showModal(id) {
      const modal = document.getElementById(id);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function hideModal(id) {
      const modal = document.getElementById(id);
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function openAddModal() {
      showModal('addModal');
    }

    function editBook(button) {
      const id = button.dataset.id;

      document.getElementById('editName').value = button.dataset.name;
      document.getElementById('editCategory').value = button.dataset.category;
      document.getElementById('editAuthor').value = button.dataset.author;
      document.getElementById('editPublisher').value = button.dataset.publisher;
      document.getElementById('editPrice').value = button.dataset.price;
      document.getElementById('editPubYear').value = button.dataset.pubYear;

      document.getElementById('editForm').action =
        '/books/' + encodeURIComponent(id);

      showModal('editModal');
    }

    let selectedBookId = null;

    function openDeleteModal(button) {
      selectedBookId = button.dataset.id;

      document.getElementById('deleteBookName').textContent =
        button.dataset.name;

      showModal('deleteModal');
    }

    async function confirmDeleteBook() {
      if (!selectedBookId) {
        alert('No book selected.');
        return;
      }

      try {
        const response = await fetch(
          '/books/' + encodeURIComponent(selectedBookId),
          { method: 'DELETE' }
        );

        if (!response.ok) {
          throw new Error('Failed to delete book.');
        }

        const data = await response.json();
        window.location.href = data.redirect || '/dashboard';

      } catch (error) {
        console.error('Delete error:', error);
        alert(error.message);
      }
    }
  </script>

{{> footer }}

