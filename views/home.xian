{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center mt-10">Welcome to XianFire 🔥</h1>
    <p class="text-center mt-4 mb-6">Home Page</p>

    {{#if currentUser}}
      <p class="text-center text-gray-500 mb-4">
        Naka-login bilang <strong>{{currentUser.name}}</strong> ({{currentUser.role}})
        — <a href="/dashboard" class="text-blue-600">Go to Dashboard</a>
      </p>
    {{/if}}

    {{#if canManage}}
      <button type="button"
              onclick="openAddModal()"
              class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition">
        + Add New Book
      </button>
    {{/if}}

    <!-- ✅ SUCCESS MESSAGE -->
    {{#if success_msg}}
      <div class="bg-green-100 text-green-800 px-4 py-3 rounded mt-4 mb-4 text-center">
        {{success_msg}}
      </div>
    {{/if}}

    {{#if error_msg}}
      <div class="bg-red-100 text-red-800 px-4 py-3 rounded mt-4 mb-4 text-center">
        {{error_msg}}
      </div>
    {{/if}}

    <!-- ✅ BOOKS TABLE -->
    {{#if books}}
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse bg-white rounded-lg shadow">
          <thead>
            <tr class="bg-gray-100 text-left">
              <th class="px-4 py-3 font-semibold text-gray-700">Name</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Category</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Author</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Publisher</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Price</th>
              <th class="px-4 py-3 font-semibold text-gray-700">Year</th>
              {{#if canManage}}
                <th class="px-4 py-3 font-semibold text-gray-700">Actions</th>
              {{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each books}}
              <tr class="border-t border-gray-100 hover:bg-gray-50">
                <td class="px-4 py-3">{{Name}}</td>
                <td class="px-4 py-3">{{#if category}}{{category}}{{else}}-{{/if}}</td>
                <td class="px-4 py-3">{{author}}</td>
                <td class="px-4 py-3">{{#if publisher}}{{publisher}}{{else}}-{{/if}}</td>
                <td class="px-4 py-3">{{#if price}}{{price}}{{else}}-{{/if}}</td>
                <td class="px-4 py-3">{{#if pub_year}}{{pub_year}}{{else}}-{{/if}}</td>
                {{#if ../canManage}}
                  <td class="px-4 py-3">
                    <button type="button"
                            onclick="editBook(this)"
                            data-id="{{id}}"
                            data-name="{{Name}}"
                            data-category="{{category}}"
                            data-author="{{author}}"
                            data-publisher="{{publisher}}"
                            data-price="{{price}}"
                            data-pub-year="{{pub_year}}"
                            class="bg-blue-500 text-white px-3 py-1 rounded text-sm mr-1 hover:bg-blue-600">
                      Edit
                    </button>
                    <button type="button"
                            onclick="openDeleteModal(this)"
                            data-id="{{id}}"
                            data-name="{{Name}}"
                            class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700">
                      Delete
                    </button>
                  </td>
                {{/if}}
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="mt-6 bg-white rounded-lg shadow p-8 text-center text-gray-500">
        No books yet.
        {{#if canManage}}Click "Add New Book" to add your first book.{{/if}}
      </div>
    {{/if}}
  </div>

  {{#if canManage}}
    <!-- ✅ ADD MODAL -->
    <div id="addModal"
         class="hidden fixed inset-0 z-50 bg-black/50 items-center justify-center p-4">
      <div class="bg-white w-full max-w-lg rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Add Book</h2>
        <form id="addForm" method="POST" action="/insert">
          <label class="block mb-1">Book Name</label>
          <input name="Name" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Category</label>
          <input name="category" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Author</label>
          <input name="author" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Publisher</label>
          <input name="publisher" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Price</label>
          <input name="price" type="number" step="0.01" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Publication Year</label>
          <input name="pub_year" type="number" required
                 class="border p-2 w-full mb-4 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <div class="flex justify-end gap-2">
            <button type="button" onclick="hideModal('addModal')"
                    class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400">
              Cancel
            </button>
            <button type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
              Add Book
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ✅ EDIT MODAL -->
    <div id="editModal"
         class="hidden fixed inset-0 z-50 bg-black/50 items-center justify-center p-4">
      <div class="bg-white w-full max-w-lg rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Edit Book</h2>
        <form id="editForm" method="POST">
          <label class="block mb-1">Book Name</label>
          <input id="editName" name="Name" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Category</label>
          <input id="editCategory" name="category" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Author</label>
          <input id="editAuthor" name="author" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Publisher</label>
          <input id="editPublisher" name="publisher" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Price</label>
          <input id="editPrice" name="price" type="number" step="0.01" required
                 class="border p-2 w-full mb-3 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <label class="block mb-1">Publication Year</label>
          <input id="editPubYear" name="pub_year" type="number" required
                 class="border p-2 w-full mb-4 rounded focus:ring-2 focus:ring-blue-500 focus:outline-none">

          <div class="flex justify-end gap-2">
            <button type="button" onclick="hideModal('editModal')"
                    class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400">
              Cancel
            </button>
            <button type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ✅ DELETE MODAL -->
    <div id="deleteModal"
         class="hidden fixed inset-0 z-[60] bg-black/50 items-center justify-center p-4">
      <div class="bg-white w-full max-w-sm rounded-xl p-6 shadow-xl">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-100">
            <span class="text-3xl text-red-600">!</span>
          </div>
          <h2 class="text-xl font-bold text-gray-800">Delete Book?</h2>
          <p class="text-gray-600 mt-2">
            Are you sure you want to delete <strong id="deleteBookName"></strong>?
            This action cannot be undone.
          </p>
        </div>
        <div class="flex justify-center gap-3 mt-6">
          <button type="button" onclick="hideModal('deleteModal')"
                  class="px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300">
            Cancel
          </button>
          <button type="button" onclick="confirmDeleteBook()"
                  class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700">
            Yes, Delete
          </button>
        </div>
      </div>
    </div>

<script>
  // ==================================================
  // MODAL HELPERS — ipakita / itago
  // ==================================================
  function showModal(id) {
    const modal = document.getElementById(id);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function hideModal(id) {
    const modal = document.getElementById(id);
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openAddModal() {
    showModal('addModal');
  }

  function editBook(button) {
    const id = button.dataset.id;
    document.getElementById('editName').value = button.dataset.name;
    document.getElementById('editCategory').value = button.dataset.category;
    document.getElementById('editAuthor').value = button.dataset.author;
    document.getElementById('editPublisher').value = button.dataset.publisher;
    document.getElementById('editPrice').value = button.dataset.price;
    document.getElementById('editPubYear').value = button.dataset.pubYear;
    document.getElementById('editForm').action = '/books/' + encodeURIComponent(id);
    showModal('editModal');
  }

  let selectedBookId = null;

  function openDeleteModal(button) {
    selectedBookId = button.dataset.id;
    document.getElementById('deleteBookName').textContent = button.dataset.name;
    showModal('deleteModal');
  }

  async function confirmDeleteBook() {
    if (!selectedBookId) {
      alert('No book selected.');
      return;
    }
    try {
      const response = await fetch(
        '/books/' + encodeURIComponent(selectedBookId),
        { method: 'DELETE' }
      );
      if (!response.ok) throw new Error('Failed to delete book.');
      const data = await response.json();
      // Naka-login — /dashboard | Hindi naka-login — /
      window.location.href = data.redirect || '/';
    } catch (error) {
      console.error('Delete error:', error);
      alert(error.message);
    }
  }
</script>
  {{/if}}

{{> footer }}
